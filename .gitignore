# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# vendored reference clones (local only)
/github/
commerce/b2c-storefront/
graphify-out/
/.worktrees/

# research audit vendored clones (local reference only)
docs/research/**/repos/

# editor cache (per-vertical)
docs/restaurant/.obsidian/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# whitelist placeholder file — F04 ships .env.example with public-shape only
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.mastra/

# Mastra local dev DB
mastra-agent-memory.db
mastra-agent-memory.db-*

# Playwright / smoke artifacts
test-results/
playwright-report/

# Local scratch
tmp/
workspace/

# Supabase CLI cache (never commit — linked-project.json may contain refs)
supabase/.temp/

# IDE / agent tooling (repo-local)
.agents/
.codex/
.cursor/
.gemini/
.vscode/
.zed/
.mcp.json
opencode.json
skills-lock.json
config/

# Accidental scrape / dump files
-

.env*.local

# ── docs/ knowledge base (migrated from outer tasks/ 2026-06-09) ────────
# Track the markdown knowledge; exclude nested repo clones, editor cache,
# and heavy binary/scraped vaults (recoverable, not source of truth).
docs/*/design/mdeapp/
docs/design/mdeapp/
docs/tasks/design/mdeapp/
docs/.obsidian/
docs/screenshots/
docs/docs-vault/
