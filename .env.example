# Public — readable by browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-jwt>
# Magic-link redirect origin (dev: http://localhost:3001 — add /auth/callback in Supabase Auth URL config)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<google-maps-api-key>
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=<google-maps-vector-map-id>
# Server-only — Gemini via @ai-sdk/google (NOT GEMINI_API_KEY or GOOGLE_API_KEY)
GOOGLE_GENERATIVE_AI_API_KEY=<gemini-api-key>
LOG_LEVEL=info
