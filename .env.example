# Public — readable by browser bundle (auth + RLS-scoped reads)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Preferred — publishable key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
# Legacy anon JWT (eyJ…) — optional if publishable key is set
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-jwt>
# Magic-link redirect origin (dev: http://localhost:3001 — add /auth/callback in Supabase Auth URL config)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# Browser Maps JS — HTTP referrer restrictions in GCP must include:
# http://localhost:3001/* http://localhost:3000/* (npm run dev pins UI to 3001)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<google-maps-api-key>
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=<google-maps-vector-map-id>
# Server-only — Places API (New) + Grounding Lite MCP (IP restriction or no referrer; NOT browser referrer key)
GOOGLE_PLACES_API_KEY=<server-places-key>
GOOGLE_MAPS_API_KEY=<server-maps-key-for-grounding-lite-mcp>
# MAP-002 — Mastra → ADK sidecar (local: http://localhost:8000; prod: Cloud Run HTTPS URL)
# Use ONE URL only — duplicate keys: last wins in Node --env-file
ADK_GROUNDING_URL=http://localhost:8000
# Server-only — shared secret for POST /v1/grounding/invoke (omit locally; required on Cloud Run + Vercel prod)
ADK_INTERNAL_TOKEN=
# MAP-002D — Google Search grounding (Mastra quota + sidecar search_grounded_events)
ENABLE_SEARCH_GROUNDING=0
SEARCH_GROUNDING_DAILY_CAP=50
# UI rollback for web citation chips (default on; set false to hide)
# NEXT_PUBLIC_WEB_CITATIONS=false
# Prefer server-restricted key for Grounding Lite MCP (sidecar also accepts GOOGLE_MAPS_API_KEY)
GOOGLE_MAPS_SERVER_API_KEY=<server-maps-key-unrestricted-or-ip>
# Server-only — Gemini via @ai-sdk/google (NOT GEMINI_API_KEY)
GOOGLE_GENERATIVE_AI_API_KEY=<gemini-api-key>
# SAN-871 · INT-023 — Flash structured router for ambiguous 0.50–0.84 band (default off)
# FLASH_ROUTE=1
# Mastra Studio Google provider (same key as above)
GOOGLE_API_KEY=<gemini-api-key>
LOG_LEVEL=info
# Optional — override Mastra workspace root (default: mdeapp/workspace)
# MDEAPP_WORKSPACE=/absolute/path/to/workspace
# Server-only — F13 ai_runs writer (never NEXT_PUBLIC_*)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-sb_secret_...>
# Mastra pg tools (search-rentals, search-attractions) — use Transaction pooler ONLY (IPv4-compatible)
# Dashboard → Connect → Transaction pooler (port 6543, user postgres.<project-ref>)
# Do NOT use direct db.<ref>.supabase.co:5432 from IPv4 networks — use pooler instead
# Password with # must be URL-encoded (%23). Example host: aws-1-us-east-1.pooler.supabase.com
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Local dev only — Mastra thread memory uses :memory: LibSQL (avoids pooler EMAXCONN from dev/HMR restarts)
# Prod/Vercel: leave unset or 0. Catalog tools still use Supabase anon (not DATABASE_URL).
MASTRA_DEV_LIBSQL=1
# Mastra search-events / search-restaurants + future Studio auth — server alias (same JWT as NEXT_PUBLIC_*)
SUPABASE_ANON_KEY=<supabase-anon-jwt>
# Vercel alias (optional): SUPABASE_SECRET_KEY = same value as SERVICE_ROLE_KEY
# CopilotKit Cloud — public key is safe in browser bundle (ck_pub_…)
NEXT_PUBLIC_COPILOTKIT_PUBLIC_API_KEY=<copilotkit-public-api-key>
# CopilotKit Cloud → your /api/copilotkit proxy auth (server-only; never NEXT_PUBLIC_*)
COPILOTKIT_API_KEY=<copilotkit-runtime-secret>
