{
  "name": "mdeapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:agent": "PORT=4111 mastra dev",
    "dev:ui": "next dev --webpack -p 3001",
    "dev:ui:worktree": "next dev --webpack -p 3002",
    "dev:ui:turbopack": "next dev --turbopack -p 3001",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:supabase": "node --env-file=.env.local scripts/verify-supabase-env.mjs",
    "verify:maps": "node --env-file=.env.local scripts/verify-maps-env.mjs",
    "verify:rental-pins": "node --env-file=.env.local scripts/verify-rental-map-pins.mjs",
    "smoke:map-pins": "node --env-file=.env.local scripts/smoke-map-chat-pins.mjs",
    "smoke:grounding-attribution": "node --env-file=.env.local scripts/smoke-grounding-attribution.mjs",
    "smoke:f50-pin-sync": "node --env-file=.env.local scripts/smoke-f50-pin-sync.mjs",
    "smoke:lead-capture": "node --env-file=.env.local scripts/smoke-lead-capture.mjs",
    "smoke:ticket-checkout": "node --env-file=.env.local scripts/smoke-ticket-checkout.mjs",
    "smoke:ticket-paid-proof": "node --env-file=.env.local scripts/smoke-ticket-paid-proof.mjs",
    "verify:console": "node --env-file=.env.local scripts/verify-localhost-console.mjs",
    "verify:console:boot": "node --env-file=.env.local scripts/verify-localhost-console-boot.mjs",
    "repro:san-902": "npx tsx docs/tasks/testing/evidence/SAN-902/san-902-host-event-3turn-repro.ts",
    "verify:grounding": "node --env-file=.env.local scripts/verify-grounding-invoke.mjs",
    "verify:grounding-enrichment": "node --env-file=.env.local scripts/verify-grounding-enrichment.mjs",
    "verify:cloud-run-grounding": "node --env-file=.env.local scripts/verify-cloud-run-grounding.mjs",
    "verify:search-grounding": "node --env-file=.env.local scripts/verify-search-grounding.mjs",
    "smoke:search-grounding": "node --env-file=.env.local scripts/smoke-search-grounding.mjs",
    "verify:mis-phase1": "node --env-file=.env.local scripts/intelligence/verify-mis-phase1.mjs",
    "smoke:golden-queries": "npx tsx --env-file=.env.local scripts/intelligence/golden-queries-smoke.ts",
    "smoke:faithfulness": "npx tsx scripts/intelligence/faithfulness-smoke.ts",
    "verify:maps-env": "node --env-file=.env.local scripts/verify-maps-env.mjs",
    "verify:commerce-env": "node scripts/verify-commerce-env.mjs",
    "verify:task": "node scripts/verify-task.mjs",
    "verify:partner-schema": "node --env-file=.env.local scripts/verify-partner-schema-gate.mjs",
    "check:mastra": "node scripts/check-mastra.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "audit:floor": "npm audit --audit-level=critical",
    "audit:copilotkit-v2": "node scripts/audit-copilotkit-v2-map.mjs",
    "audit:copilotkit-v2:depcruise": "depcruise --config .dependency-cruiser.cjs src && node scripts/audit-copilotkit-v2-no-new-v1.mjs",
    "audit:copilotkit-v2:depcruise:proof": "node scripts/audit-copilotkit-v2-depcruise-proof.mjs",
    "floor": "npm run lint && npm run typecheck && npm run build && npm test && npm run audit:floor",
    "test:veb-mvp-010-integration": "node scripts/verify-veb-mvp-010-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test e2e/maps-layout-desktop.spec.ts",
    "test:e2e:mobile": "playwright test e2e/maps-layout-mobile.spec.ts",
    "test:e2e:grounding": "playwright test e2e/maps-grounding.spec.ts",
    "test:e2e:screens": "playwright test e2e/screens --project=chromium --workers=1",
    "test:e2e:host-events": "playwright test e2e/screens/SCREEN-016c-host-events-authed.spec.ts --project=chromium --workers=1",
    "test:e2e:venue-release": "playwright test e2e/screens/VEN-035-venue-release.spec.ts --project=chromium --workers=1",
    "test:e2e:auth": "playwright test e2e/auth-guard.spec.ts --project=chromium --workers=1",
    "test:e2e:copilot-budget": "playwright test e2e/copilotkit-request-budget.spec.ts --project=chromium --workers=1",
    "test:e2e:restaurant-fast-path": "playwright test e2e/restaurant-card-fast-path.spec.ts --project=chromium --workers=1",
    "test:e2e:concierge-run-error": "playwright test e2e/concierge-run-error.spec.ts --project=chromium --workers=1",
    "test:e2e:p0-focused": "npm run test:e2e:copilot-budget && npm run test:e2e:restaurant-fast-path && npm run test:e2e:concierge-run-error",
    "test:e2e:live-audit": "playwright test e2e/live-audit-verticals.spec.ts --project=chromium --workers=1",
    "test:e2e:card-unification": "playwright test e2e/card-unification.spec.ts --project=chromium --workers=1",
    "test:e2e:visual-cards": "playwright test e2e/visual-all-cards.spec.ts --project=chromium --workers=1",
    "commit:staged-guard:c012": "node scripts/commit-staged-guard.mjs c012",
    "commit:staged-guard:c013": "node scripts/commit-staged-guard.mjs c013",
    "test:e2e:new-chat": "playwright test e2e/concierge-new-chat.spec.ts --project=chromium --workers=1",
    "test:e2e:prod-synthetic": "PROD_SMOKE_BASE_URL=${PROD_SMOKE_BASE_URL:-https://www.mdeai.co} PW_SKIP_WEBSERVER=1 playwright test e2e/prod-synthetic-smoke.spec.ts --project=chromium --workers=1",
    "test:e2e:prod-journey-j05-j20": "PROD_SMOKE_BASE_URL=${PROD_SMOKE_BASE_URL:-https://www.mdeai.co} PW_SKIP_WEBSERVER=1 playwright test e2e/prod-journey-j05-j20.spec.ts --project=chromium --workers=1",
    "verify:commerce-mdeapp-env": "node --env-file=.env.local scripts/verify-commerce-mdeapp-env.mjs",
    "smoke:commerce-client": "npx tsx --env-file=.env.local scripts/smoke-commerce-client.ts",
    "check": "npm run typecheck && npm test -- --run",
    "floor:fast": "concurrently --kill-others-on-fail \"npm:lint\" \"npm:typecheck\" \"npm:test\" && npm run build && npm run audit:floor",
    "test:mastra": "vitest run src/mastra/",
    "test:lib": "vitest run src/lib/",
    "test:hooks": "vitest run src/hooks/",
    "test:api": "vitest run src/app/api/"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.52",
    "@ag-ui/mastra": "beta",
    "@ai-sdk/google": "2.0.74",
    "@base-ui/react": "^1.5.0",
    "@copilotkit/react-core": "1.55.2",
    "@copilotkit/react-ui": "1.55.2",
    "@copilotkit/runtime": "1.55.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@googlemaps/places": "2.4.1",
    "@langchain/core": "1.1.48",
    "@libsql/client": "^0.15.15",
    "@mastra/client-js": "beta",
    "@mastra/core": "beta",
    "@mastra/libsql": "beta",
    "@mastra/memory": "beta",
    "@mastra/pg": "^1.1.0-alpha.2",
    "@medusajs/js-sdk": "2.13.4",
    "@medusajs/types": "2.13.4",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@vercel/analytics": "^2.0.1",
    "@vis.gl/react-google-maps": "^1.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "libsql": "^0.5.22",
    "lucide-react": "^1.16.0",
    "mastra": "beta",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "pg": "^8.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-qr-code": "^2.0.21",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.1.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "prismjs": ">=1.30.0",
    "langsmith": ">=0.5.27",
    "shell-quote": ">=1.8.4"
  },
  "engines": {
    "node": ">=20"
  }
}
