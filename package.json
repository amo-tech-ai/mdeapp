{
  "name": "mdeapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:ui\" \"npm run dev:agent\" --names ui,agent --prefix-colors blue,green --kill-others",
    "dev:agent": "PORT=4111 mastra dev",
    "dev:ui": "next dev --webpack -p 3001",
    "dev:ui:turbopack": "next dev --turbopack -p 3001",
    "dev:debug": "LOG_LEVEL=debug npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mastra": "vitest run src/mastra src/__tests__/smoke.test.ts",
    "verify:supabase": "node --env-file=.env.local scripts/verify-supabase-env.mjs",
    "verify:supabase:data": "node --env-file=.env.local scripts/verify-supabase-data.mjs",
    "test:supabase": "vitest run src/lib/supabase/__tests__",
    "verify:maps": "node --env-file=.env.local scripts/verify-maps-env.mjs",
    "verify:rental-pins": "node --env-file=.env.local scripts/verify-rental-map-pins.mjs",
    "smoke:map-pins": "node --env-file=.env.local scripts/smoke-map-chat-pins.mjs",
    "smoke:grounding-attribution": "node --env-file=.env.local scripts/smoke-grounding-attribution.mjs",
    "smoke:f50-pin-sync": "node --env-file=.env.local scripts/smoke-f50-pin-sync.mjs",
    "smoke:lead-capture": "node --env-file=.env.local scripts/smoke-lead-capture.mjs",
    "smoke:ticket-checkout": "node --env-file=.env.local scripts/smoke-ticket-checkout.mjs",
    "smoke:ticket-paid-proof": "node --env-file=.env.local scripts/smoke-ticket-paid-proof.mjs",
    "verify:console": "node --env-file=.env.local scripts/verify-localhost-console.mjs",
    "verify:console:boot": "node --env-file=.env.local scripts/verify-localhost-console-boot.mjs",
    "verify:grounding": "node --env-file=.env.local scripts/verify-grounding-invoke.mjs",
    "verify:grounding-enrichment": "node --env-file=.env.local scripts/verify-grounding-enrichment.mjs",
    "verify:cloud-run-grounding": "node --env-file=.env.local scripts/verify-cloud-run-grounding.mjs",
    "verify:search-grounding": "node --env-file=.env.local scripts/verify-search-grounding.mjs",
    "smoke:search-grounding": "node --env-file=.env.local scripts/smoke-search-grounding.mjs",
    "verify:maps-env": "node --env-file=.env.local scripts/verify-maps-env.mjs",
    "smoke:places-new": "node --env-file=.env.local scripts/smoke-places-new.mjs",
    "smoke:adk-grounding": "node --env-file=.env.local scripts/smoke-adk-grounding.mjs",
    "test:maps": "vitest run src/mastra/lib/google-places-client.test.ts src/mastra/lib/adk-grounding-client.test.ts src/mastra/lib/map-adk-grounding-pins.test.ts src/mastra/tools/__tests__/search-grounded-places-quality.test.ts src/mastra/tools/__tests__/search-grounded-places-fallback.test.ts src/mastra/tools/__tests__/search-grounded-places-cafe-fallback.test.ts",
    "test:cards": "vitest run src/platform/copilot/__tests__/rich-card-results.test.ts src/components/copilot/__tests__/search-tool-renders-cards.test.ts src/components/copilot/__tests__/card-interaction-a11y.test.tsx src/components/copilot/__tests__/rental-card-copy.test.tsx src/components/copilot/__tests__/cafe-result-card.test.tsx src/components/copilot/__tests__/event-card.test.tsx src/components/copilot/__tests__/place-result-card.test.tsx src/lib/normalize-tool-envelope.test.ts",
    "test:ux-stack": "npm run test:cards && npm run test:mastra && npm run test:maps && npm run test:supabase",
    "check:mastra": "node scripts/check-mastra.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "floor": "npm run lint && npm run typecheck && npm run build && npm test && npm run audit",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test e2e/maps-layout-desktop.spec.ts",
    "test:e2e:mobile": "playwright test e2e/maps-layout-mobile.spec.ts",
    "test:e2e:grounding": "playwright test e2e/maps-grounding.spec.ts",
    "test:e2e:screens": "playwright test e2e/screens --project=chromium --workers=1",
    "test:e2e:ux": "playwright test e2e/concierge-run-error.spec.ts e2e/live-audit-verticals.spec.ts e2e/rich-card-dedup.spec.ts --project=chromium --workers=1",
    "commit:staged-guard:c012": "node scripts/commit-staged-guard.mjs c012",
    "commit:staged-guard:c013": "node scripts/commit-staged-guard.mjs c013"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.52",
    "@ag-ui/mastra": "beta",
    "@ai-sdk/google": "2.0.74",
    "@base-ui/react": "^1.5.0",
    "@copilotkit/react-core": "1.55.2",
    "@copilotkit/react-ui": "1.55.2",
    "@copilotkit/runtime": "1.55.2",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@googlemaps/places": "2.4.1",
    "@libsql/client": "^0.15.15",
    "@mastra/client-js": "beta",
    "@mastra/core": "beta",
    "@mastra/libsql": "beta",
    "@mastra/memory": "beta",
    "@mastra/pg": "^1.1.0-alpha.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@vis.gl/react-google-maps": "^1.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "libsql": "^0.5.22",
    "lucide-react": "^1.16.0",
    "mastra": "beta",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-qr-code": "^2.0.21",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.6",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "prismjs": ">=1.30.0",
    "langsmith": ">=0.5.27"
  }
}
